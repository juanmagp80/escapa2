<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Debug builds allow cleartext HTTP so the app can be tested against a
        local backend over the LAN (e.g. http://192.168.1.10:8000). Release
        builds only use HTTPS.
    -->
    <application android:usesCleartextTraffic="true" />

</manifest>
