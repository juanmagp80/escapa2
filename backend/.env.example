APP_NAME=Escapa2 Radar API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
APP_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg://escapa2:escapa2@localhost:5432/escapa2
# Persistence backend: memory (default, no DB required) or sql.
PERSISTENCE_BACKEND=memory
CORS_ALLOWED_ORIGINS=["http://localhost:8080"]

GEMINI_ENABLED=true
# Generate a key at https://aistudio.google.com/apikey and put it only in your
# local .env (never commit it). The example file must not contain secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_REQUESTS_PER_USER_DAY=20

AMADEUS_ENABLED=false
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Default points to the Amadeus test/sandbox environment.
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_TIMEOUT_SECONDS=15

GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Path to the service account JSON file (preferred on a server).
FIREBASE_CREDENTIALS_FILE=
# Alternative: paste the full JSON content of the service account directly.
# Prefer a secret manager / Render Secret Files over inline env vars when possible.
FIREBASE_CREDENTIALS_JSON=

SCHEDULER_ENABLED=false
# How often the scheduler checks for watches whose next_run_at has passed.
SCHEDULER_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
